APP_NAME="AssocMap"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database: Supabase PostgreSQL Session Pooler ──────────────
# Copy this file as ".env", then provide the actual database password.
# Never commit the real password to Git.
DB_CONNECTION=pgsql
DB_HOST=aws-1-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.lzdxtrrhzdwldujacztm
DB_PASSWORD=
DB_SSLMODE=require

# ── Session: stored in the PostgreSQL sessions table ──────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Cache and Queue: stored in PostgreSQL ─────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Broadcasting and File Storage ─────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Mail ───────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@bfar.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# ── Vite ──────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
